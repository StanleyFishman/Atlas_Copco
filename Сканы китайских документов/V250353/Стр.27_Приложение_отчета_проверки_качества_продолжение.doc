    <style>
        @page {
            size: A4 landscape;
            margin: 10mm 15mm 10mm 15mm;
        }
        body {
            font-family: 'Times New Roman', SimSun, serif;
            font-size: 8pt;
            margin: 0;
            padding: 10px;
            line-height: 1.3;
        }
        .doc-header {
            text-align: right;
            font-size: 9pt;
            margin-bottom: 10px;
            color: #666;
        }
        .title {
            text-align: center;
            font-size: 16pt;
            font-weight: bold;
            margin: 15px 0 20px 0;
        }
        .title-english {
            text-align: center;
            font-size: 11pt;
            font-weight: bold;
            margin-bottom: 20px;
            color: #333;
        }
        .header-info {
            display: table;
            width: 100%;
            margin-bottom: 15px;
            font-size: 9pt;
        }
        .header-info-row {
            display: table-row;
        }
        .header-info-cell {
            display: table-cell;
            padding: 5px 10px;
            vertical-align: middle;
        }
        .header-info-cell.label {
            font-weight: bold;
            width: 15%;
        }
        .header-info-cell.value {
            width: 35%;
        }
        .inspection-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 7pt;
            table-layout: fixed;
        }
        .inspection-table th, .inspection-table td {
            border: 1px solid #000;
            padding: 3px 4px;
            text-align: center;
            vertical-align: middle;
        }
        .inspection-table th {
            background-color: #e0e0e0;
            font-weight: bold;
        }
        .inspection-table .col-item {
            width: 12%;
            text-align: left;
            padding-left: 5px;
        }
        .inspection-table .col-sample {
            width: 3.5%;
        }
        .inspection-table .empty-cell {
            background-color: #f9f9f9;
        }
        .footer {
            display: table;
            width: 100%;
            margin-top: 20px;
            font-size: 9pt;
        }
        .footer-left, .footer-center, .footer-right {
            display: table-cell;
            vertical-align: bottom;
            padding: 10px;
        }
        .footer-left {
            width: 40%;
        }
        .footer-center {
            width: 30%;
            text-align: center;
        }
        .footer-right {
            width: 30%;
            text-align: right;
        }
        .signature-name {
            font-weight: bold;
            color: #c00;
        }
    </style>
</head>
