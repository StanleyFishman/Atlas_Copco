            color: #003366;
        }
        .logo-sub {
            font-size: 9pt;
            color: #003366;
        }
        .title {
            text-align: center;
            font-size: 16pt;
            font-weight: bold;
            margin: 15px 0;
        }
        .info-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 9pt;
            margin-bottom: 20px;
        }
        .info-table td {
            border: 1px solid #000;
            padding: 5px 8px;
            vertical-align: top;
        }
        .info-table td:first-child {
            font-weight: bold;
            width: 180px;
            background-color: #f5f5f5;
        }
        .graph-section {
            margin: 20px 0;
            padding: 15px;
            border: 2px solid #000;
            background-color: #fafafa;
        }
