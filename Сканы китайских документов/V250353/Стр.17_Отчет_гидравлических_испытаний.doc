<body>
    <div class="logo-header">
        <span class="logo">宇博科技</span><br>
        <span class="logo-sub">YUBO TECH</span>
    </div>
    
    <div class="title">ОТЧЁТ ГИДРАВЛИЧЕСКИХ ИСПЫТАНИЙ</div>
    
    <table class="info-table">
        <tr>
            <td>Заводской номер</td>
            <td>V250353</td>
        </tr>
        <tr>
            <td>Место испытания</td>
            <td>Корпус</td>
        </tr>
        <tr>
            <td>Дата испытания</td>
            <td>2025.04.25</td>
        </tr>
        <tr>
            <td>Номер технологической карты</td>
            <td>PFC-07</td>
        </tr>
        <tr>
            <td>Класс точности манометра</td>
            <td>1.6</td>
        </tr>
        <tr>
            <td>Диапазон манометра (МПа)</td>
            <td>0~4 МПа</td>
        </tr>
        <tr>
            <td>Срок действия поверки манометра</td>
            <td>2025.10.01</td>
        </tr>
        <tr>
            <td>Номер манометра</td>
            <td>FP09, FP10</td>
        </tr>
        <tr>
