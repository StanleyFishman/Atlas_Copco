        }
        .conclusion-section {
            margin: 20px 0;
            padding: 15px;
            border: 2px solid #000;
            background-color: #f0f0f0;
        }
        .conclusion-section p {
            margin: 8px 0;
            font-size: 10pt;
            line-height: 1.6;
        }
        .signatures {
            display: table;
            width: 100%;
            margin-top: 30px;
            font-size: 10pt;
        }
        .sig-block {
            display: table-cell;
            width: 33%;
            padding: 0 10px;
        }
        .sig-name {
            font-weight: bold;
            color: #c00;
        }
