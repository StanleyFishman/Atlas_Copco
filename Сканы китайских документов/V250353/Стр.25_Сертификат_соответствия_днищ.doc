    <style>
        @page {
            size: A4;
            margin: 15mm 20mm 15mm 20mm;
        }
        body {
            font-family: 'Times New Roman', SimSun, serif;
            font-size: 10pt;
            margin: 0;
            padding: 15px;
            line-height: 1.6;
        }
        .doc-number {
            text-align: right;
            font-size: 9pt;
            color: #666;
            margin-bottom: 20px;
        }
        .title {
            text-align: center;
            font-size: 18pt;
            font-weight: bold;
            margin: 20px 0 30px 0;
        }
        .title-english {
            text-align: center;
            font-size: 12pt;
            font-weight: bold;
            margin-bottom: 30px;
            color: #333;
        }
        .info-table {
            width: 100%;
            border-collapse: collapse;
            margin: 20px 0;
            font-size: 10pt;
        }
        .info-table td {
            border: 1px solid #000;
            padding: 8px 12px;
            vertical-align: middle;
        }
        .info-table .label {
            background-color: #f0f0f0;
            font-weight: bold;
            width: 25%;
        }
        .info-table .value {
            width: 25%;
        }
        .checkbox-group {
            display: inline-block;
            margin-right: 20px;
        }
        .checkbox-group input[type="checkbox"] {
            margin-right: 5px;
        }
        .compliance-statement {
            margin: 25px 0;
            font-size: 10pt;
            line-height: 1.8;
            text-align: justify;
            padding: 15px;
            background-color: #f9f9f9;
            border-left: 4px solid #0066cc;
        }
        .signatures-section {
            margin-top: 40px;
            font-size: 10pt;
        }
        .signatures-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }
        .signatures-table td {
            padding: 10px;
            vertical-align: bottom;
            border: none;
        }
        .signatures-table .label {
            font-weight: bold;
            width: 25%;
        }
        .signatures-table .signature-cell {
            width: 35%;
            position: relative;
            min-height: 60px;
        }
        .signature-name {
            font-weight: bold;
            color: #c00;
            margin-bottom: 5px;
        }
        .signature-date {
            font-size: 9pt;
            color: #333;
        }
        .stamp-area {
            position: relative;
            margin-top: 10px;
        }
        .stamp-circular {
            display: inline-block;
            width: 100px;
            height: 100px;
            border: 2px solid #c00;
            border-radius: 50%;
            color: #c00;
            font-weight: bold;
            font-size: 8pt;
            padding: 5px;
            text-align: center;
            line-height: 1.2;
            opacity: 0.7;
        }
        .contact-info {
            margin-top: 40px;
            font-size: 9pt;
            line-height: 1.8;
        }
        .qr-section {
            position: absolute;
            bottom: 20px;
            left: 20px;
            text-align: center;
            font-size: 8pt;
        }
        .qr-code {
            width: 60px;
            height: 60px;
            border: 1px solid #ccc;
            background-color: #f9f9f9;
            margin-bottom: 5px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
    </style>
</head>
<body>
    <div class="doc-number">文档编号 Document No.: HD-Q-03</div>
    
    <div class="title">封头产品合格证</div>
    <div class="title-english">Head Product Qualification Certificate</div>
    
    <table class="info-table">
        <tr>
            <td class="label">制造单位<br>(Manufacturing Unit)</td>
            <td class="value">江阴市恒达金属压件有限公司<br>(Цзянъинь Хэнда Металл Прессинг Партс Ко., Лтд.)</td>
            <td class="label">订货单位<br>(Ordering Unit)</td>
            <td class="value">宇博<br>(Юбо)</td>
        </tr>
        <tr>
            <td class="label">订货编号<br>(Order Number)</td>
            <td class="value">/</td>
            <td class="label">订货技术条件编号或图号<br>(Order Technical Condition No. or Drawing No.)</td>
            <td class="value">/</td>
        </tr>
        <tr>
            <td class="label">材料来源<br>(Material Source)</td>
            <td class="value" colspan="3">
                来料加工 (Processing with supplied materials)
            </td>
        </tr>
        <tr>
            <td class="label">材料牌号<br>(Material Grade)</td>
            <td class="value"><strong>Q345R</strong></td>
            <td class="label">材料标准<br>(Material Standard)</td>
            <td class="value">/</td>
        </tr>
        <tr>
            <td class="label">设计标记[类型代号D×δn(δmin)]<br>(Design Mark [Type Code D×δn(δmin)])</td>
            <td class="value" colspan="3">
                <strong>EHA1800×10 (8.74) -Q345R GB/T25198-2023</strong>
            </td>
        </tr>
        <tr>
            <td class="label">产品标记[类型代号D×δn(δmin)-δs]<br>(Product Mark [Type Code D×δn(δmin)-δs])</td>
            <td class="value" colspan="3">
                <strong>EHA1800×10 (8.74)-10-Q345R GB/T25198-2023</strong>
            </td>
        </tr>
        <tr>
            <td class="label">产品编号<br>(Product Number)</td>
            <td class="value" colspan="3">
                <strong>LA250368-1~12</strong>
            </td>
        </tr>
        <tr>
            <td class="label">制造完工日期<br>(Manufacturing Completion Date)</td>
            <td class="value">
                <strong>2025年03月17日</strong><br>
                (17 марта 2025 г.)
            </td>
            <td class="label">封头出厂状况<br>(Head Ex-factory Status)</td>
            <td class="value">
                <div class="checkbox-group">
                    ☑ 整体出厂<br>
                    (Whole product ex-factory)
                </div>
                <div class="checkbox-group">
                    ☐ 整体成形后分割出厂<br>
                    (Split after overall forming ex-factory)
                </div>
                <div class="checkbox-group">
                    ☐ 分瓣出厂<br>
                    (Segmented ex-factory)
                </div>
            </td>
        </tr>
    </table>
    
    <div class="compliance-statement">
        <p><strong>该封头产品在制造过程中经质量检验,符合GB/T25198-2023《压力容器封头》以及其设计文件或订货技术条件的要求。</strong></p>
        <p style="margin-top: 10px;"><strong>This head product has undergone quality inspection during the manufacturing process and complies with GB/T25198-2023 "Pressure Vessel Heads" and its design documents or order technical conditions.</strong></p>
        <p style="margin-top: 10px;">(Данное днище прошло проверку качества в процессе изготовления и соответствует требованиям GB/T25198-2023 «Днища сосудов под давлением», а также его проектной документации или техническим условиям заказа.)</p>
    </div>
    
    <div class="signatures-section">
        <table class="signatures-table">
            <tr>
                <td class="label">质量负责人签章<br>(Quality Manager Signature)</td>
                <td class="signature-cell">
                    <div class="signature-name">关明</div>
                    <div class="signature-date">(Гуань Мин)</div>
                    <div class="stamp-area">
                        <div class="stamp-circular">
                            质量负责人<br>
                            专用章
                        </div>
                    </div>
                    <div class="signature-date" style="margin-top: 10px;">
                        <strong>2025年03月17日</strong><br>
                        (17 марта 2025 г.)
                    </div>
                </td>
                <td class="label">企业法人签章<br>(Legal Representative Signature)</td>
                <td class="signature-cell">
                    <div class="signature-name">英胡</div>
                    <div class="signature-date">(Ин Ху)</div>
                    <div class="stamp-area">
                        <div class="stamp-circular">
                            企业法人<br>
                            专用章
                        </div>
                    </div>
                    <div class="signature-date" style="margin-top: 10px;">
                        <strong>2025年03月17日</strong><br>
                        (17 марта 2025 г.)
                    </div>
                </td>
            </tr>
        </table>
        
        <div style="margin-top: 30px; text-align: center;">
            <div class="stamp-circular" style="width: 120px; height: 120px; font-size: 9pt;">
                江阴市恒达金属压件有限公司<br>
                产品质量检验专用章<br>
                <br>
