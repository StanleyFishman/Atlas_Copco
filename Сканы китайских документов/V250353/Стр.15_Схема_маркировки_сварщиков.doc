    <style>
        @page {
            size: A4;
            margin: 15mm 20mm 15mm 20mm;
        }
        body {
            font-family: 'Times New Roman', SimSun, serif;
            font-size: 10pt;
            margin: 0;
            padding: 15px;
            line-height: 1.5;
        }
        .logo-header {
            margin-bottom: 20px;
        }
        .logo {
            font-size: 14pt;
            font-weight: bold;
            color: #003366;
        }
        .logo-sub {
            font-size: 9pt;
            color: #003366;
        }
        .title {
            text-align: center;
            font-size: 18pt;
            font-weight: bold;
            margin: 20px 0 30px 0;
        }
        .product-info {
            text-align: right;
            font-size: 10pt;
            margin-bottom: 15px;
            font-weight: bold;
        }
        .content-container {
            display: table;
            width: 100%;
            margin: 20px 0;
        }
        .diagram-section {
            display: table-cell;
            width: 65%;
            vertical-align: top;
            padding-right: 15px;
        }
        .table-section {
            display: table-cell;
            width: 35%;
            vertical-align: top;
            padding-left: 15px;
        }
        .welds-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 8pt;
            margin-top: 10px;
        }
        .welds-table th, .welds-table td {
            border: 1px solid #000;
            padding: 4px 6px;
            text-align: center;
            vertical-align: middle;
        }
        .welds-table th {
            background-color: #e0e0e0;
            font-weight: bold;
        }
        .welds-table .col-part {
            width: 60%;
        }
        .welds-table .col-welder {
            width: 40%;
        }
        .diagram-container {
            margin: 20px 0;
            min-height: 450px;
            border: 1px solid #ccc;
            padding: 20px;
            text-align: center;
            background-color: #f9f9f9;
        }
        .diagram-description {
            font-size: 9pt;
            color: #666;
            margin-top: 15px;
            line-height: 1.8;
            text-align: left;
        }
        .footer {
            margin-top: 40px;
            font-size: 9pt;
        }
        .signatures {
            display: table;
            width: 100%;
            margin-top: 30px;
        }
        .sig-block {
            display: table-cell;
            width: 50%;
            vertical-align: top;
            padding: 10px;
        }
        .sig-label {
            font-weight: bold;
            margin-bottom: 40px;
        }
        .sig-name {
            font-weight: bold;
            color: #c00;
            margin-top: 10px;
        }
        .sig-date {
            margin-top: 10px;
            font-size: 9pt;
        }
