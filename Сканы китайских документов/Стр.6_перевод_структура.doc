                <td class="col-result">✔ Соответствует</td>
            </tr>
            <tr>
                <td class="col-num">4</td>
                <td class="col-item">Овальность корпуса по длине 3 м</td>
                <td class="col-unit">mm</td>
                <td class="col-norm">≤1.8</td>
                <td class="col-actual">0.5</td>
                <td class="col-result">✔ Соответствует</td>
            </tr>
            <tr>
                <td class="col-num">5</td>
                <td class="col-item">Овальность корпуса</td>
                <td class="col-unit">mm</td>
                <td class="col-norm">≤18</td>
                <td class="col-actual">4</td>
                <td class="col-result">✔ Соответствует</td>
            </tr>
            <tr>
                <td class="col-num">6</td>
