                <td class="col-norm">3374</td>
                <td class="col-actual">3376</td>
                <td class="col-result">✔ Соответствует</td>
            </tr>
            <tr>
                <td class="col-num">2</td>
                <td class="col-item">Внутренний диаметр</td>
