                <th rowspan="2">Энергия (кВ)</th>
                <th rowspan="2">Ток трубки (активность источника) мА(Бк)</th>
                <th rowspan="2">Время экспозиции (мин)</th>
                <th rowspan="2">Требуемая чувствительность качества изображения (номер проволоки)</th>
                <th rowspan="2">Длина шва (мм)</th>
                <th rowspan="2">Длина однократного просвечивания (мм)</th>
                <th rowspan="2">Уровень приемки (уровень)</th>
                <th rowspan="2">Требуемый процент контроля (%)</th>
                <th rowspan="2">Фактический процент контроля (%)</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>A1</td>
