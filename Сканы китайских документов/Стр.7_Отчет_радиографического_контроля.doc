    <div class="title">ОТЧЁТ РАДИОГРАФИЧЕСКОГО КОНТРОЛЯ СВАРНЫХ ШВОВ</div>
    
    <div class="product-info">
        <div class="product-left"><strong>Заводской номер:</strong> V250353</div>
        <div class="product-right"><strong>Наименование изделия:</strong> Осушитель</div>
    </div>
    
    <table class="setup-table">
        <tr>
            <td>Марка материала</td>
            <td>Q345R</td>
            <td>Вид источника</td>
            <td><span class="checkbox">☑</span> Ir192 <span class="checkbox">☐</span> Co60</td>
        </tr>
        <tr>
            <td>Размер фокусного пятна</td>
            <td>3×1 мм</td>
            <td>Способ усиления</td>
            <td><span class="checkbox">☑</span> PbFe передний экран 0.03 задний экран 0.03</td>
        </tr>
        <tr>
            <td>Модель индикатора качества изображения</td>
            <td>10FeJB</td>
            <td>Формула проявителя</td>
            <td>花冠牌 (Huaguan)</td>
        </tr>
        <tr>
            <td>Технический уровень радиографического контроля</td>
            <td><span class="checkbox">☑</span> A <span class="checkbox">☑</span> B</td>
            <td>Момент контроля</td>
            <td>После сварки</td>
        </tr>
        <tr>
            <td>Модель оборудования</td>
            <td>XXHA3005</td>
            <td>Марка плёнки</td>
            <td>AGFA-C7</td>
        </tr>
        <tr>
            <td>Спецификация плёнки</td>
            <td>360×80 мм</td>
            <td>Условия промывки</td>
            <td><span class="checkbox">☑</span> Ручная <span class="checkbox">☐</span> Автоматическая</td>
        </tr>
        <tr>
            <td>Условия проявления</td>
            <td>Время 5 мин; Температура 20±2℃</td>
            <td>Плотность рентгенограммы</td>
            <td>2.0~4.5</td>
        </tr>
    </table>
    
    <table class="main-table">
        <thead>
            <tr>
                <th rowspan="2">№ шва</th>
